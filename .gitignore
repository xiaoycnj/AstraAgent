# Local state and secrets
/data/
/memory/*
!/memory/README.md
.env
.env.*
!.env.example
*.pem
*.key
*.sqlite3*

# Bundled runtimes live in Standard release assets.
/runtimes/*
!/runtimes/manifest.json
!/runtimes/python/
/runtimes/python/*
!/runtimes/python/python314._pth
!/runtimes/python/sitecustomize.py

# Generated files
__pycache__/
*.pyc
*.pyo
.graphflow*
graphflow-out/
/dist/
/build/
/outputs/
/work/
/.venv/
/node_modules/
/%SystemDrive%/

# Only built-in capabilities are public by default.
/skills/*
!/skills/README.md
!/skills/engineer/
!/skills/general/
!/skills/planner/
!/skills/study/
!/skills/writer/
/skills/*/*
!/skills/*/SKILL.md
/plugins/*
!/plugins/README.md
!/plugins/agent-dispatch/
!/plugins/code-review/
!/plugins/data-lab/
!/plugins/decision-log/
!/plugins/goals/
!/plugins/long-memory/
!/plugins/notebook/
!/plugins/research-browser/
!/plugins/skill-creator/
!/plugins/task-board/
!/plugins/workflow-studio/
!/plugins/world-tree/
!/plugins/writing-kit/
!/plugins/writing-studio/
/plugins/*/*
!/plugins/*/manifest.json

!/plugins/image-generation/
!/plugins/image-generation/manifest.json
