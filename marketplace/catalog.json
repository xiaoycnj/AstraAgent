{
  "schema_version": 1,
  "entries": [
    {
      "schema_version": 1,
      "id": "focus-session",
      "kind": "plugin",
      "name": "专注会话",
      "description": "发送前限制超长输入，回复完成后显示提醒。",
      "author": "cnxiaoy",
      "license": "MIT",
      "version": "1.0.0",
      "payload": {
        "schema_version": 2,
        "id": "focus-session",
        "name": "专注会话",
        "description": "发送前限制超长输入，回复完成后显示提醒。",
        "version": "1.0.0",
        "hooks": [
          {
            "event": "before_send",
            "action": "limit_length",
            "value": 12000
          },
          {
            "event": "after_response",
            "action": "notify",
            "value": "专注会话 · 回复已完成"
          }
        ],
        "panels": []
      },
      "sha256": "88992247b1fbdee9c5e1e0d7b365709138c15c9549d925018e357fbb5a14f854"
    },
